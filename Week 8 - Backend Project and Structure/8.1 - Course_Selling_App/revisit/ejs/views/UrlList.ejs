<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>DashBoard</h1>
    <ul>
        <% urls.forEach(url => { %>
                <li><a href="http://localhost:3000/url/<%= url.shortCode %>"><%= url.shortCode %></a> - <%= url.originalUrl %> - Clicks: <%= url.clicks %></li>
        <% }) %>
    </ul>
    
</body>
</html>